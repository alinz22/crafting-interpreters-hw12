// Real closures. Makes a counter and calls it in a hot loop, so every call goes
// through a closure and reads and writes an upvalue.
fun makeCounter() {
  var count = 0;
  fun next() {
    count = count + 1;
    return count;
  }
  return next;
}

var start = clock();
var next = makeCounter();
for (var i = 0; i < 5000000; i = i + 1) next();
print clock() - start;
